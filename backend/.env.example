# 复制为 backend/.env 后按需修改。docker compose 会自动读取同目录的 .env。
# 默认管理员（种子写入，bcrypt 哈希落库）：
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD=admin123
# 其余演示账号（DEMO=true 时出现在 GET /api/meta 的 demoAccounts 里，生产请关掉）：
#   owner1 / owner123    号主 王老板
#   owner2 / owner123    号主 李老板
#   demo   / demo123     内部成员
#   cs     / cs123       客服
#   ops    / ops123      运营
#   admin  / admin123    管理员（与上面 ADMIN_* 一致）

POSTGRES_USER=delta
POSTGRES_PASSWORD=delta
POSTGRES_DB=delta_rental

# 容器内主机名是 db。本机直接跑 Node、数据库在 compose 里时，把 @db 改成 @127.0.0.1
DATABASE_URL=postgresql://delta:delta@db:5432/delta_rental?schema=public&connection_limit=5&pool_timeout=10

# 截图 URL 的 HMAC 密钥。生产请换成至少 16 位的随机串。
JWT_SECRET=change-me-please-use-a-long-random-string
# 不透明会话：滑动续期小时数，以及绝对最长天数
SESSION_SLIDE_HOURS=12
SESSION_ABSOLUTE_DAYS=7

PORT=3000
UPLOAD_DIR=/data/uploads
NODE_ENV=production

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 生产环境建议都设为 false。DEMO 也接受 ENABLE_DEMO_ACCOUNTS 这个旧名字。
DEMO=true
ENABLE_DEMO_RESET=true

# 登录限流识别真实客户端 IP。默认信任本机和内网反代（1Panel / Docker 网桥）。
# 不要设成 true。只有一层、且 API 不对公网开放时，也可以设成 1。
# TRUST_PROXY=loopback,uniquelocal

# 超期订单自动转入待结算的间隔（毫秒）。0 表示不定时扫。
# ORDER_SWEEP_MS=60000
